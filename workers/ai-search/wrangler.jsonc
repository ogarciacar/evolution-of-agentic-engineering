{
  "name": "agentic-engineering-search-api",
  "main": "./index.js",
  "compatibility_date": "2026-09-05",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "agenticengineering.science/api/search*",
      "zone_name": "agenticengineering.science"
    }
  ],
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      "namespace": "default",
      "remote": true
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ANSWER_ENABLED": "true"
  },
  "ratelimits": [
    {
      "name": "ANSWER_RATE_LIMITER",
      "namespace_id": "2026100501",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ]
}
