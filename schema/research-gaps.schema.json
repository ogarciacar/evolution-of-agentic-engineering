{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticengineering.science/schema/research-gaps.schema.json",
  "title": "Agentic Engineering Research Gaps",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "model_version", "research_gaps"],
  "properties": {
    "version": { "const": 1 },
    "model_version": { "const": 2 },
    "research_gaps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim_id", "stage", "question", "evidence_needed"],
        "properties": {
          "claim_id": { "type": "string", "pattern": "^C[0-9]{2}$" },
          "stage": {
            "enum": ["Apparition", "Selection", "Cooperation", "Specialization"]
          },
          "question": { "type": "string", "minLength": 1 },
          "evidence_needed": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
