{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agenticengineering.science/schema/evidence.schema.json",
  "title": "Evolution of Agentic Engineering evidence record",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "presentation", "observed", "scale", "mapping", "interpretation", "model_implication", "what_this_does_not_establish", "open_question", "assessment"],
  "properties": {
    "source": {"type":"object","additionalProperties":false,"required":["title","producer","producer_type","date","url","type","provenance"],"properties":{"title":{"type":"string","minLength":1},"producer":{"type":"string","minLength":1},"producer_type":{"type":"string","enum":["organization","authors","individual","project"]},"date":{"type":"string","format":"date"},"url":{"type":"string","format":"uri","pattern":"^https://"},"type":{"type":"string","enum":["engineering-blog","paper","repository","documentation","changelog","report","benchmark","talk"]},"provenance":{"type":"string","enum":["primary","secondary"]}}},
    "presentation": {"type":"object","additionalProperties":false,"required":["headline"],"properties":{"headline":{"type":"string","minLength":1},"summary":{"type":"string","minLength":1}}},
    "observed": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "scale": {"type":"object","additionalProperties":false,"required":["label","summary"],"properties":{"label":{"type":"string","enum":["Scale signal","Evidence boundary"]},"summary":{"type":"string","minLength":1}}},
    "mapping": {"type":"object","additionalProperties":false,"required":["stages","conditions"],"properties":{"stages":{"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/stage"}},"conditions":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/condition"}},"transition":{"type":"object","additionalProperties":false,"required":["from","to"],"properties":{"from":{"$ref":"#/$defs/stage"},"to":{"$ref":"#/$defs/stage"},"adjacent_stage":{"$ref":"#/$defs/stage"}}}}},
    "claims": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"object","additionalProperties":false,"required":["id","relationship"],"properties":{"id":{"type":"string","pattern":"^C[0-9]{2}$"},"relationship":{"type":"string","enum":["SUPPORTS","REFINES","CONTRADICTS","INCONCLUSIVE"]}}}},
    "practice_assessment": {"$ref":"#/$defs/practice_assessment"},
    "practice_observations": {"type":"array","items":{"$ref":"#/$defs/practice_observation"}},
    "interpretation": {"type":"string","minLength":1},
    "model_implication": {"type":"object","additionalProperties":false,"required":["verdict","explanation"],"properties":{"verdict":{"type":"string","enum":["SUPPORTS","REFINES","CONTRADICTS","INCONCLUSIVE"]},"explanation":{"type":"string","minLength":1}}},
    "what_this_does_not_establish": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "open_question": {"type":"string","minLength":1},
    "assessment": {"type":"object","additionalProperties":false,"required":["assisted_by_ai"],"properties":{"assisted_by_ai":{"type":"boolean"}}}
  },
  "$defs": {
    "stage": {"type":"string","enum":["Apparition","Selection","Cooperation","Specialization"]},
    "condition": {"type":"string","enum":["Context","Execution","Verification","Coordination","Observability","Economics","Learning"]},
    "practice_selection_condition": {"type":"string","enum":["context","execution","verification","coordination","observability","economics","learning"]},
    "practice_assessment": {
      "type":"object",
      "additionalProperties":false,
      "required":["status"],
      "properties":{"status":{"type":"string","enum":["pending","assessed"]}}
    },
    "practice_observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "use_case", "problem", "reported_practice", "selection_conditions"],
      "properties": {
        "id": {"type":"string","minLength":1},
        "use_case": {"type":"string","minLength":1,"description":"What the organization was trying to accomplish, as reported or directly evidenced by the source."},
        "problem": {"type":"string","minLength":1,"description":"The difficulty or constraint reported or directly evidenced by the source."},
        "reported_practice": {"type":"string","minLength":1,"description":"A concrete practice reported or directly evidenced by the source, not a recommendation inferred by the researcher."},
        "selection_conditions": {"type":"array","minItems":1,"uniqueItems":true,"items":{"$ref":"#/$defs/practice_selection_condition"},"description":"Analytical classification of the conditions under which the reported practice appears selected."}
      }
    }
  }
}
