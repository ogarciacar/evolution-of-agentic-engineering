{
  "name": "eae-evidence-interaction",
  "private": true,
  "scripts": {
    "test:unit": "vitest run --config tests/investigate/vitest.config.mjs",
    "test:worker": "vitest run --config tests/investigate/vitest.worker.config.mjs",
    "test:acceptance": "playwright test --config tests/investigate/playwright.config.mjs",
    "test:contracts": "node workers/ai-search/check-search-endpoint.mjs && node workers/ai-search/check-preview-bridge.mjs && node workers/ai-search/check-search-ui.mjs",
    "check": "npm run test:unit && npm run test:worker && npm run test:contracts && npm run test:acceptance"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.6",
    "@playwright/test": "1.62.1",
    "vitest": "4.1.11"
  }
}
